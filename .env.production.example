# Copy to .env before: docker compose -f docker-compose.prod.yml --env-file .env up -d

POSTGRES_USER=fleetkit
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=fleetkit

FLEETKIT_SECRET_KEY=replace-with-at-least-32-random-chars
FLEETKIT_BOOTSTRAP_EMAIL=admin@example.com
FLEETKIT_BOOTSTRAP_PASSWORD=replace-with-strong-admin-password
FLEETKIT_CORS_ORIGINS=https://fleetkit.example.com

# Published images from GitHub Packages (GHCR). Override to build locally.
FLEETKIT_IMAGE_TAG=0.1.0
# FLEETKIT_API_IMAGE=ghcr.io/blessed-bless/fleetkit-api
# FLEETKIT_WEB_IMAGE=ghcr.io/blessed-bless/fleetkit-web

FLEETKIT_HTTP_PORT=8080
