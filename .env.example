# FleetKit local defaults — copy to .env
FLEETKIT_ENV=development
FLEETKIT_SECRET_KEY=change-me-to-a-long-random-string
FLEETKIT_DATABASE_URL=postgresql+asyncpg://fleetkit:fleetkit@localhost:5432/fleetkit
FLEETKIT_REDIS_URL=redis://localhost:6379/0
FLEETKIT_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FLEETKIT_BOOTSTRAP_EMAIL=admin@example.com
FLEETKIT_BOOTSTRAP_PASSWORD=fleetkit-admin
FLEETKIT_API_HOST=0.0.0.0
FLEETKIT_API_PORT=8000
